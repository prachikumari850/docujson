# Application
STORAGE_DIR=../storage
MAX_UPLOAD_MB=50

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=neetday

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Authentication and security
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PASSWORD_RESET_EXPIRE_MINUTES=30
CSRF_SECRET=replace-with-a-random-secret-at-least-32-characters

# CORS
CORS_ORIGINS=http://localhost:5173

# OCR / Tesseract
TESSERACT_CMD= C:/Program Files/Tesseract-OCR/tesseract.exe
TESSDATA_PREFIX=
OCR_LANGUAGES=eng+hin
OCR_DPI=300

# Image and mathematical expression processing
MEDIA_CROP_MARGIN_PT=6
MATH_CROP_DPI=288

# Optional Ollama visual verification
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SECONDS=90

# Optional Groq visual verification
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=120